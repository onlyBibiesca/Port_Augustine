  dialogueName: Event_1
  lines:
  - speakerName: Kimmy
    text: Hahaaa..! Hell yes...
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: fbc06258b2e73ca4dbd8cc25d69b7541, type: 3}
  - speakerName: Kimmy
    text: '<Kimmy seems to be busy working on something behind the counter.>

'
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: f910b4775f540be448cc8b9e3323e7f3, type: 3}
  - speakerName: Kimmy
    text: "Hey! You know what this is? It\u2019s a frickin\u2019 legend in gaming
      history!"
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: f910b4775f540be448cc8b9e3323e7f3, type: 3}
  - speakerName: Kimmy
    text: Someone brought in a vintage, mint condition PS2 for me to fix! A PS-freaking-two!
      In this good condition, in this country? What a once in a lifetime thing to
      work in!
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: fbc06258b2e73ca4dbd8cc25d69b7541, type: 3}
  - speakerName: Kimmy
    text: "I\u2019ll be busy for a while! Check back with me later!"
    hasChoices: 1
    choices:
    - choiceText: Always games with you, huh?
      nextDialogue: {fileID: 0}
      relationshipChange: 0
      choiceType: -1
      requiredTrait: {fileID: 0}
      gainedTrait: {fileID: 0}
      hideIfTraitMissing: 0
    - choiceText: Have fun!
      nextDialogue: {fileID: 0}
      relationshipChange: 0
      choiceType: 1
      requiredTrait: {fileID: 0}
      gainedTrait: {fileID: 0}
      hideIfTraitMissing: 0
