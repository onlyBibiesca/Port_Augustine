  dialogueName: Event_1
  lines:
  - speakerName: Maja
    text: <Maja seems to be cleaning the store windows. They notice you from the
      reflection from the glass and it startles them a bit.>
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: c8caca9d50cfa474f8cf179dbbf5b9c8, type: 3}
  - speakerName: Maja
    text: "A-ah! It\u2019s.. it\u2019s you. Sorry, I get startled easily\u2026 odd
      seeing me outside, huh? Yes, I know."
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: c8caca9d50cfa474f8cf179dbbf5b9c8, type: 3}
  - speakerName: Maja
    text: <They wipe the screen with a squeegee, gently cleaning it with a cloth.>
    hasChoices: 1
    choices:
    - choiceText: You look tired.
      nextDialogue: {fileID: 0}
      relationshipChange: 0
      choiceType: 1
      requiredTrait: {fileID: 0}
      gainedTrait: {fileID: 0}
      hideIfTraitMissing: 0
    - choiceText: Well, you seem busy. I'll leave you to it.
      nextDialogue: {fileID: 0}
      relationshipChange: 0
      choiceType: -1
      requiredTrait: {fileID: 0}
      gainedTrait: {fileID: 0}
      hideIfTraitMissing: 0
