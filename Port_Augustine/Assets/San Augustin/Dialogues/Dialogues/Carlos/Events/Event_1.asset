  dialogueName: Event_1
  lines:
  - speakerName: Carlos
    text: "Aaaghh, I should\u2019ve never trusted that guy online. I knew it was
      too good to be true..!"
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: 13ba91cbc9c6a3d4b9eedbc23db1ee8f, type: 3}
  - speakerName: Carlos
    text: "Flaked off before he saw me open the package. Damn that scamming prick\u2026"
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: 13ba91cbc9c6a3d4b9eedbc23db1ee8f, type: 3}
  - speakerName: Carlos
    text: "Yawa \u2013 unsa man ni oy! This is SERIOUSLY not what I ordered!"
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: 13ba91cbc9c6a3d4b9eedbc23db1ee8f, type: 3}
  - speakerName: Carlos
    text: <Carlos kicked dust from the sidewalk in a frustrated manner.>
    hasChoices: 0
    choices: []
    characterPortrait: {fileID: 21300000, guid: 13ba91cbc9c6a3d4b9eedbc23db1ee8f, type: 3}
  - speakerName: Carlos
    text: "Tch\u2026"
    hasChoices: 1
    choices:
    - choiceText: You know what they say about playing stupid games...
      nextDialogue: {fileID: 0}
      relationshipChange: 0
      choiceType: -1
      requiredTrait: {fileID: 0}
      gainedTrait: {fileID: 0}
      hideIfTraitMissing: 0
    - choiceText: It happens. Sometimes people are just mean.
      nextDialogue: {fileID: 0}
      relationshipChange: 0
      choiceType: 1
      requiredTrait: {fileID: 0}
      gainedTrait: {fileID: 0}
      hideIfTraitMissing: 0
